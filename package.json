{
  "name": "briar-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @briar/display dev",
    "dev:node": "pnpm --filter @briar/node dev",
    "dev:shared": "pnpm --filter @briar/shared dev",
    "build": "pnpm --filter @briar/shared build && pnpm --filter @briar/display build",
    "build:shared": "pnpm --filter @briar/shared build",
    "preview": "pnpm --filter @briar/display preview",
    "install:all": "pnpm install"
  },
  "devDependencies": {}
}
