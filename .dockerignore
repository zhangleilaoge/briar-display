**/node_modules
packages/*/dist
packages/briar-display/web
packages/briar-node/jobs
**/.astro
**/.cache

# 运行期产物
logs
*.log
.DS_Store

# 密钥与资产（运行时挂载，不进镜像）
briar-assets

# 文档与部署脚本（构建不需要）
docs
scripts/deploy.sh
scripts/deploy-nginx.sh
scripts/deploy-server.expect
scripts/server-setup.sh
