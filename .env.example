# 数据库配置
BRIAR_DATABASE_HOST=localhost
BRIAR_DATABASE_USER=your_username
BRIAR_DATABASE_PASSWORD=your_password
BRIAR_DATABASE_PORT=3306

# JWT 密钥（随机字符串）
BRIAR_JWT_SECRET=your_jwt_secret_key_here

# 服务器端口
PORT=3888

# 腾讯云 COS 配置（用于上传 CDN 和生产环境资源访问，同时也是 ACME DNS-01 自动验证的密钥）
BRIAR_TX_BUCKET_REGION=ap-shanghai
BRIAR_TX_SEC_ID=your_secret_id
BRIAR_TX_SEC_KEY=your_secret_key
BRIAR_TX_BUCKET_NAME=your_bucket_name
BRIAR_TX_BUCKET_DOMAIN=https://your-bucket.cos.ap-shanghai.myqcloud.com
# 用户文件私有读 bucket（/briar/files 图床文件，访问走后端签名 URL）
BRIAR_TX_PRIVATE_BUCKET_NAME=your_private_bucket_name

# ACME / Let's Encrypt 配置
ACME_EMAIL=your-email@example.com
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
CERTIFICATE_DOMAIN=xiaobuzi.cn

# 远程服务器 SSH 配置（Agent 直连调试用，写入 briar-assets/briar/.env）
DEPLOY_HOST=your_server_ip
DEPLOY_PORT=22
DEPLOY_USER=your_username
DEPLOY_PASS=your_password

# GitHub API（用于管理后台查看 CI 发布日志，需 actions:read 权限；
# 不配则兜底读取 briar-assets/github/.env 的 FINED_GRAINED_GITHUB_TOKEN）
BRIAR_GITHUB_TOKEN=your_github_token
BRIAR_GITHUB_REPO=zhangleilaoge/briar-display

# 海外站点出站代理（媒体解析 Pornhub 等国内不可达平台用，页面抓取与媒体下载共用同一出口；
# 支持 http/https 代理，如 http://127.0.0.1:7890；不配则直连，国内服务器上 Pornhub 解析不可用）
BRIAR_MEDIA_OUTBOUND_PROXY=

# 抖音访客 cookie（媒体解析抖音通道必需，2026-10 起 detail 接口签保护）：
# 浏览器打开 douyin.com 后从 devtools 复制 cookie 串，至少含 UIFID_TEMP 或 UIFID；
# s_v_web_id 缺失时会本地伪造。有效期约数月，失效后抖音解析 403，更新后 pm2 restart briar-node
BRIAR_DOUYIN_COOKIE=

# 全球板块行情（/briar/markets）上游代理：直连失败时用它重试一次（Naver 等海外源、或国内源临时封 IP 时兜底）；
# 支持 http/https 代理，如 http://127.0.0.1:7890；不配则只直连
BRIAR_MARKET_PROXY=
# 全球板块行情缓存（进程内全局共享）：交易时段 TTL 秒数（限定 15–30，默认 20）；缓存条目上限（LRU，限定 50–5000，默认 500）
BRIAR_MARKET_CACHE_TTL_SECONDS=
BRIAR_MARKET_CACHE_MAX=

# Google OAuth（登录页「使用 Google 登录」）
# 在 Google Cloud Console 创建「Web 应用」OAuth 客户端后填入；切勿提交真实 Secret
# 授权重定向 URI 须与 BRIAR_GOOGLE_REDIRECT_URI 完全一致：
#   生产：https://xiaobuzi.cn/api/auth/google/callback
#   本地：http://localhost:3888/api/auth/google/callback
BRIAR_GOOGLE_CLIENT_ID=
BRIAR_GOOGLE_CLIENT_SECRET=
BRIAR_GOOGLE_REDIRECT_URI=https://xiaobuzi.cn/api/auth/google/callback
