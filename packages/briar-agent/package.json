		"ink": "^7.0.3",
		"ink-scroll-view": "^0.3.7",
		"ink-text-input": "^6.0.0",
		"react": "^19.2.6"
	},
	"devDependencies": {
		"@types/blessed": "^0.1.27",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.14",
		"tsup": "^8.0.0",
		"typescript": "^5.3.0"
	}
}
