{
	"name": "@briar/agent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"briar": "dist/main.js"
	},
	"scripts": {
		"build": "tsup && chmod +x dist/main.js",
