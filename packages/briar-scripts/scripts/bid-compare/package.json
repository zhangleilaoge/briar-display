{
	"name": "bid-compare",
	"version": "2.0.0",
	"description": "施工方案文档比对工具 - 串标风险排查 (TypeScript + Python 混合架构)",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun src/index.ts",
		"compare": "bun src/index.ts",
		"compare:resume": "bun src/index.ts --resume",
		"compare:cli": "bun src/index.ts --docs",
		"clean": "rm -rf bid_compare_result .compare-cache",
		"test": "bun test",
		"check": "bunx tsc --noEmit && bunx @biomejs/biome check src/",
		"benchmark": "bun src/benchmark.ts",
		"desktop:build": "cd ../bid-compare-desktop && ./build.sh",
		"desktop:build:mac-intel": "cd ../bid-compare-desktop && ./build.sh mac-intel",
		"desktop:build:mac-silicon": "cd ../bid-compare-desktop && ./build.sh mac-silicon",
		"desktop:build:windows": "cd ../bid-compare-desktop && ./build.sh windows",
		"desktop:release": "cd ../bid-compare-desktop && ./build.sh --release",
		"desktop:release:mac-intel": "cd ../bid-compare-desktop && ./build.sh mac-intel --release",
		"desktop:release:mac-silicon": "cd ../bid-compare-desktop && ./build.sh mac-silicon --release",
		"desktop:release:windows": "cd ../bid-compare-desktop && ./build.sh windows --release",
		"desktop:bump": "cd ../bid-compare-desktop && ./scripts/bump-version.sh patch"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"commander": "^12.0.0"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
