---
import SharedDemo from '../../../components/demo/astro/SharedDemo.astro'
import { RibbonSidebar } from '../../../components/ui/ribbon-sidebar'
import Layout from '../../../layouts/Layout.astro'
---

<Layout title="Hello World">
	<RibbonSidebar client:load currentPath={Astro.url.pathname} />
	<main class="rv-page min-h-screen">
		<div class="mx-auto max-w-3xl px-6 py-10">
			<span class="rv-script block text-3xl text-[color:var(--rv-rose-deep)]">Petite page</span>
			<h1 class="font-heading text-3xl font-semibold text-foreground">Hello World 子页面</h1>
			<SharedDemo />
			<p class="text-sm text-muted-foreground">这是 /demo/hello/world 路由页面</p>
			<div class="mt-4 flex gap-4 font-control text-sm tracking-control text-muted-foreground">
				<a class="underline-offset-4 hover:underline" href="/demo/hello">← 返回 Hello 页面</a>
				<a class="underline-offset-4 hover:underline" href="/demo">返回 Demo 首页</a>
			</div>
		</div>
	</main>
</Layout>
