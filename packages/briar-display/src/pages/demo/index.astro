---
import SharedDemo from '../../components/demo/astro/SharedDemo.astro'
import Welcome from '../../components/demo/astro/Welcome.astro'
import ApiTest from '../../components/demo/react/ApiTest.tsx'
import { RibbonSidebar } from '../../components/ui/ribbon-sidebar'
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Demo">
	<RibbonSidebar client:load currentPath={Astro.url.pathname} />
	<main class="rv-page min-h-screen">
		<div class="mx-auto max-w-3xl px-6 pb-16">
			<Welcome />
			<SharedDemo />
			<ApiTest client:load />
		</div>
	</main>
</Layout>
