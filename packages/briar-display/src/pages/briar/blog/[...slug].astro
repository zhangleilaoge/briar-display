---
import { getCollection, render } from 'astro:content'
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { formatDate, getReadingStats } from '../../../lib/blog'

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((p) => !p.data.draft)
		.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: posts[i - 1] ?? null, // 发布时间更新的一篇
			older: posts[i + 1] ?? null, // 发布时间更早的一篇
		},
	}))
}

const { post, newer, older } = Astro.props
const { Content } = await render(post)
const stats = getReadingStats(post.body)
---

<BlogLayout title={`${post.data.title} · 博客`} description={post.data.description}>
	<div class="blog-progress" id="blog-progress" aria-hidden="true"></div>

	<div class="blog-shell">
		<header class="article-header blog-rise">
			<a class="article-back" href="/briar/blog/">← 全部文章</a>
			<h1 class="article-title">{post.data.title}</h1>
			<p class="article-meta">
				<time>{formatDate(post.data.date)}</time>
				<span class="post-item-dot"></span>
				<span>{stats.words} 字 · 约 {stats.minutes} 分钟</span>
			</p>
			{
				post.data.tags.length > 0 && (
					<ul class="article-tags">
						{post.data.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
			<div class="blog-ornament" aria-hidden="true"><span></span></div>
		</header>

		<article class="blog-article blog-rise" style="--i:1">
			<Content />
		</article>

		<nav class="article-nav blog-rise" style="--i:2">
			{
				older ? (
					<a class="article-nav-card" href={`/briar/blog/${older.id}/`}>
						<span class="article-nav-label">← 更早一篇</span>
						<span class="article-nav-title">{older.data.title}</span>
					</a>
				) : (
					<span />
				)
			}
			{
				newer ? (
					<a class="article-nav-card newer" href={`/briar/blog/${newer.id}/`}>
						<span class="article-nav-label">更新一篇 →</span>
						<span class="article-nav-title">{newer.data.title}</span>
					</a>
				) : (
					<span />
				)
			}
		</nav>

		<footer class="blog-footer">
			<a href="/briar/blog/">← 全部文章</a>
		</footer>
	</div>

	<script>
		const bar = document.getElementById('blog-progress')
		const onScroll = () => {
			const doc = document.documentElement
			const max = doc.scrollHeight - doc.clientHeight
			const ratio = max > 0 ? window.scrollY / max : 0
			if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`
		}
		window.addEventListener('scroll', onScroll, { passive: true })
		onScroll()
	</script>
</BlogLayout>
