---
import { MARKET_IDS, MARKET_LABELS, type MarketId } from '@briar/shared'
import SiteApp from '../../../components/common/SiteApp'
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
	return MARKET_IDS.map((market) => ({ params: { market } }))
}

const market = Astro.params.market as MarketId
---

<Layout title={`${MARKET_LABELS[market]}板块 - 行情`}>
	<SiteApp client:load initialPath={`/briar/markets/${market}`} />
</Layout>
