---
// 每个子路径仍生成静态 HTML；进入后由全站 SiteApp 接管客户端导航。
import { ADMIN_ROUTES } from '../../../components/admin/adminRoutes'
import SiteApp from '../../../components/common/SiteApp'
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
	return ADMIN_ROUTES.map((r) => ({
		params: { slug: r.path.replace('/briar/admin/', '') },
		props: { path: r.path, title: r.title },
	}))
}

const { path, title } = Astro.props
---

<Layout title={title}>
	<SiteApp client:load initialPath={path} />
</Layout>
