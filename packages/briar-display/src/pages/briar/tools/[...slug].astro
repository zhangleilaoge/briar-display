---
// 工具箱 SPA：所有 /briar/tools/<tool> 共用同一页面壳，子路由在客户端切换（见 ToolsApp）。
// 每个子路径都生成静态 HTML，保证刷新/深链直达。
import ToolsApp, { TOOL_ROUTES } from '../../../components/tools/ToolsApp'
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
	return TOOL_ROUTES.map((r) => ({
		params: { slug: r.path.replace('/briar/tools/', '') },
		props: { path: r.path, title: r.title },
	}))
}

const { path, title } = Astro.props
---

<Layout title={title}>
	<ToolsApp client:load initialPath={path} />
</Layout>
