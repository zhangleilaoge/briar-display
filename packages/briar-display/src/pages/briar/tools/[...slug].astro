---
// 每个子路径仍生成静态 HTML；进入后由全站 SiteApp 接管客户端导航。
import SiteApp from '../../../components/common/SiteApp'
import { TOOL_ROUTES } from '../../../components/tools/toolRoutes'
import Layout from '../../../layouts/Layout.astro'

export function getStaticPaths() {
	return TOOL_ROUTES.map((r) => ({
		params: { slug: r.path.replace('/briar/tools/', '') },
		props: { path: r.path, title: r.title },
	}))
}

const { path, title } = Astro.props
---

<Layout title={title}>
	<SiteApp client:load initialPath={path} />
</Layout>
