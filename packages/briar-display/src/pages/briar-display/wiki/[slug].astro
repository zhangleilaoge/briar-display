---
// 由于路径是动态的且列表依赖于数据库，我们提供空的 getStaticPaths
// 其数据将在客户端从 API 加载
export async function getStaticPaths() {
  return []
}

import Layout from "@/layouts/Layout.astro"
import WikiDetailBySlug from "@/components/wiki/WikiDetailBySlug"

const { slug } = Astro.params
---

<Layout title="Wiki 文章 | Briar Wiki">
  <div class="container mx-auto max-w-3xl px-4 py-8">
    <div class="mb-8">
      <a
        href="/briar-display/wiki"
        class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 mb-4"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        返回列表
      </a>
    </div>

    <WikiDetailBySlug client:load slug={slug ?? ""} />
  </div>
</Layout>
