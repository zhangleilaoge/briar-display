---
import Layout from "@/layouts/Layout.astro"
import MyWikisPage from "@/components/wiki/MyWikisPage"
---

<Layout title="我的文章 | Briar Wiki">
  <div class="container mx-auto max-w-4xl px-4 py-8">
    <div class="mb-8">
      <a
        href="/briar-display/wiki"
        class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 mb-4"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        返回首页
      </a>
      <h1 class="text-4xl font-bold mb-2">我的文章</h1>
      <p class="text-gray-600">管理和编辑您的 Wiki 文章</p>
    </div>

    <MyWikisPage client:load />
  </div>
</Layout>
