---
import { APP_NAME, type User, formatDate, generateId } from '@briar/shared'

const currentDate = formatDate(new Date())
const sampleId = generateId()

const sampleUser: User = {
	id: sampleId,
	name: 'Test User',
	email: 'test@example.com',
	createdAt: new Date(),
}
---

<div class="shared-demo">
  <h2>@briar/shared 示例</h2>
  <div class="info">
    <p><strong>应用名称：</strong>{APP_NAME}</p>
    <p><strong>当前日期：</strong>{currentDate}</p>
    <p><strong>生成的 ID：</strong>{sampleId}</p>
  </div>
  <div class="user-info">
    <h3>示例用户数据：</h3>
    <pre>{JSON.stringify(sampleUser, null, 2)}</pre>
  </div>
</div>

<style>
  .shared-demo {
    border: 2px solid #646cff;
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
    background: #f9f9f9;
  }

  .shared-demo h2 {
    color: #646cff;
    margin-top: 0;
  }

  .info p {
    margin: 8px 0;
  }

  .user-info {
    margin-top: 20px;
  }

  .user-info h3 {
    margin-bottom: 10px;
  }

  pre {
    background: #fff;
    padding: 12px;
    border-radius: 4px;
    overflow-x: auto;
  }
</style>
