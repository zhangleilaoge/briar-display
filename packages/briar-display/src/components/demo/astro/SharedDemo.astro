---
import { APP_NAME, type User, formatDate, generateId } from '@briar/shared'

const currentDate = formatDate(new Date())
const sampleId = generateId()

const sampleUser: User = {
	id: sampleId,
	name: 'Test User',
	email: 'test@example.com',
	createdAt: new Date(),
}
---

<div class="rv-surface my-6 rounded-surface border border-border/80 p-6 shadow-surface">
	<span class="rv-label text-[10px] text-muted-foreground">Partagé</span>
	<h2 class="mt-1 font-heading text-xl font-semibold text-foreground">@briar/shared 示例</h2>
	<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
		<dt class="text-muted-foreground">应用名称</dt><dd class="text-foreground">{APP_NAME}</dd>
		<dt class="text-muted-foreground">当前日期</dt><dd class="text-foreground">{currentDate}</dd>
		<dt class="text-muted-foreground">生成的 ID</dt><dd class="rv-code break-all text-foreground">{sampleId}</dd>
	</dl>
	<h3 class="mt-5 font-heading text-base font-semibold text-foreground">示例用户数据</h3>
	<!-- 代码块保持朴素 IDE 风格 -->
	<pre class="rv-code mt-2 overflow-x-auto rounded-md border border-[#e5e7eb] bg-[#fafafa] p-3 text-[12px] text-[#1f2937]">{JSON.stringify(sampleUser, null, 2)}</pre>
</div>
