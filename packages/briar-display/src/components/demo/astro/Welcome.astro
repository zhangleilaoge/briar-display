---
import { buttonVariants } from '../../ui/button'
// Demo 欢迎卡片：Reverie Scrapbook 风格（奶油纸卡片 + 花体 + 古典衬线 + 药丸按钮）
---

<section class="rv-surface relative mt-10 overflow-hidden rounded-surface border border-border/80 px-8 py-10 shadow-raised">
	<span class="rv-script block text-3xl text-[color:var(--rv-rose-deep)]">Bienvenue</span>
	<h1 class="mt-1 font-heading text-3xl font-semibold text-foreground">Astro Demo 页面</h1>
	<p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
		这里演示 Astro + React + Vue 混合渲染与 <code class="rv-code rounded bg-muted px-1.5 py-0.5 text-[12px]">@briar/shared</code> 共享包。页面文件位于
		<code class="rv-code rounded bg-muted px-1.5 py-0.5 text-[12px]">src/pages/demo</code>。
	</p>
	<div class="mt-6 flex flex-wrap gap-3">
		<a
			class="inline-flex h-9 items-center rounded-control px-5 font-control text-sm tracking-control text-primary-foreground shadow-control transition-shadow [background-image:var(--btn-primary-image)] hover:shadow-control-hover"
			href="https://docs.astro.build"
			target="_blank"
			rel="noreferrer">阅读 Astro 文档</a
		>
		<a
			class="inline-flex h-9 items-center rounded-control border border-border bg-card/80 px-5 font-control text-sm tracking-control text-foreground shadow-control transition-shadow hover:shadow-control-hover"
			href="/demo/hello">Hello 子页面 →</a
		>
	</div>
	<span class="rv-label absolute right-6 top-6 text-[10px] text-muted-foreground">Carnet · Demo</span>
</section>
