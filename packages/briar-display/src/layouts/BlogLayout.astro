---
import '../styles/globals.css'
import '../styles/theme.css'
import '../styles/fonts'
import '../styles/blog.css'
import floralSecession from '../assets/decor/floral-secession.svg'
import { RibbonSidebar } from '../components/ui/ribbon-sidebar'

interface Props {
	title?: string
	description?: string
}

const { title = '博客', description } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/briar/favicons/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body class="blog-theme theme-scrapbook rv-page">
		<RibbonSidebar client:load currentPath={Astro.url.pathname} />
		<div aria-hidden class="rv-blog-decor pointer-events-none fixed inset-0 -z-10 overflow-hidden">
			<span class="rv-watermark-num absolute -left-4 top-8 text-[10rem] opacity-35 md:left-16 md:text-[12rem]">04</span>
			<img src={floralSecession.src ?? floralSecession} alt="" class="rv-cutout absolute bottom-10 right-8 hidden h-28 w-auto opacity-[0.14] xl:block" />
		</div>
		<div class="md:pl-16">
			<slot />
		</div>
	</body>
</html>
