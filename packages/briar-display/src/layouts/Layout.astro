---
import '../styles/globals.css'
import '../styles/theme.css'
import '../styles/fonts'
import { type ReverieTheme, themeClass, themeForPath } from '../lib/theme'

interface Props {
	title?: string
	theme?: ReverieTheme
}

const { title = 'Briar', theme } = Astro.props
const bodyTheme = themeClass(theme ?? themeForPath(Astro.url.pathname))
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/briar/favicons/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={['rv-page min-h-screen bg-background text-foreground antialiased', bodyTheme]}>
    <slot />
  </body>
</html>
