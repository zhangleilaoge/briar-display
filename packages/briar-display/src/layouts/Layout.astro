---
import '../styles/globals.css'

const { title = 'Briar' } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="https://briar-shanghai-1309736035.cos.ap-shanghai.myqcloud.com/images/111204716_p0_master1200-1780675319868.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
